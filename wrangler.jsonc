{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "goepi-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Endereço público do blog (goepi.com.br/blog). As passkeys ficam presas a
	// este domínio. blog.goepi.com.br continua aceito como origem extra
	// enquanto os usuários migram as chaves do endereço antigo.
	"vars": {
		"EMDASH_SITE_URL": "https://goepi.com.br",
		"EMDASH_ALLOWED_ORIGINS": "https://blog.goepi.com.br",
	},
	// O blog responde em goepi.com.br/blog. O resto de goepi.com.br continua
	// no projeto Pages "goepi" (repositório goepi-br/website): estas rotas
	// passam na frente dele só nos caminhos do blog e do EmDash.
	"routes": [
		{ "pattern": "blog.goepi.com.br", "custom_domain": true },
		{ "pattern": "goepi.com.br/blog*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/_emdash/*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/_astro/*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/_image*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/_server-islands/*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/sitemap*", "zone_name": "goepi.com.br" },
		{ "pattern": "goepi.com.br/robots.txt", "zone_name": "goepi.com.br" },
		// www.goepi.com.br inteiro passa por aqui só para ser redirecionado (301)
		// para goepi.com.br: assim o Google não vê o site duplicado em dois endereços.
		{ "pattern": "www.goepi.com.br/*", "zone_name": "goepi.com.br" },
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "bc2c5303-1af0-4997-af68-dae05af66b55",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
