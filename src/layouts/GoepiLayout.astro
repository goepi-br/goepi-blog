---
/**
 * Layout do Blog GoEPI: mesmo cabeçalho e estilos do site goepi.com.br
 * (ver homeBlog.pdf e itemBlog.pdf no repositório goepi-br/website).
 */
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import GoogleTagManager from "../components/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "../components/GoogleTagManagerNoscript.astro";
import StripJsonLd from "../components/StripJsonLd.astro";
import { createPublicPageContext } from "emdash/page";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	bodyClass?: string;
	content?: { collection: string; id: string; slug?: string | null };
	/**
	 * JSON-LD próprio da página. Quando é passado, o BlogPosting básico do
	 * EmDash sai do <head> e fica só este (ver src/utils/blog-schema.ts).
	 */
	jsonLd?: Record<string, unknown> | null;
}

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	bodyClass = "blog-page",
	content,
	jsonLd = null,
} = Astro.props;

/** JSON seguro dentro de <script>: escapa "<" para não fechar a tag. */
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;

const siteName = "Blog GoEPI";
/** Imagem de compartilhamento padrão (a mesma do site), quando o post não tem capa. */
const shareImage = image || "https://goepi.com.br/assets/og/goepi-og.jpg";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title,
	description,
	canonical,
	image: shareImage,
	content,
	seo: { ogImage: shareImage, robots },
	articleMeta: { publishedTime, modifiedTime },
	siteName,
});
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<StripJsonLd types={jsonLd ? ["BlogPosting"] : []}><EmDashHead page={pageCtx} /></StripJsonLd>
		{jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
		<GoogleTagManager />
		<meta name="theme-color" content="#040A1F" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="Feed RSS do Blog GoEPI" href="/blog/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/blog/assets/styles.css" />
	</head>
	<body class={bodyClass}>
		<EmDashBodyStart page={pageCtx} />
		<GoogleTagManagerNoscript />
		<header class="navbar navbar--solid" id="navbar">
			<div class="container navbar__inner">
				<a href="/" class="navbar__logo"><img src="/blog/assets/logo-goepi.png" alt="GoEPI" height="32" /></a>
				<nav class="navbar__links" aria-label="Navegação principal">
					<a href="/#fluxo">Como funciona</a>
					<a href="/about">Nossa história</a>
					<a href="/#suporte">Perguntas Frequentes</a>
					<a href="/blog" aria-current="page">Blog</a>
				</nav>
				<a href="/#demonstracao" class="btn btn--yellow"
					>Agendar demonstração <span class="btn__circle btn__circle--yellow2" aria-hidden="true"
						><img src="/blog/assets/arrow-right.png" alt="" /></span
					></a
				>
				<button class="navbar__burger" aria-label="Abrir menu" aria-expanded="false"><span></span><span></span><span></span></button>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
		<script is:inline>
			(function () {
				var navbar = document.getElementById("navbar");
				var burger = document.querySelector(".navbar__burger");
				if (!navbar || !burger) return;
				burger.addEventListener("click", function () {
					var open = navbar.classList.toggle("menu-open");
					burger.setAttribute("aria-expanded", String(open));
					document.body.style.overflow = open ? "hidden" : "";
				});
				document.querySelectorAll(".navbar__links a").forEach(function (link) {
					link.addEventListener("click", function () {
						navbar.classList.remove("menu-open");
						burger.setAttribute("aria-expanded", "false");
						document.body.style.overflow = "";
					});
				});
			})();
		</script>
	</body>
</html>
