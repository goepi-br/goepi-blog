---
import { formatShortDate, imageUrl, splitTitle } from "../utils/goepi";

interface Props {
	slug: string;
	title: string;
	excerpt?: string | null;
	image?: unknown;
	category?: string | null;
	date?: Date | null;
}

const { slug, title, excerpt, image, category, date } = Astro.props;
const href = `/posts/${encodeURIComponent(slug)}`;
const [highlight, rest] = splitTitle(title);
---

<article class="blog-card">
	<a class="blog-card__image" href={href} aria-label={`Ler ${title}`}>
		<img src={imageUrl(image)} alt="" loading="lazy" />
		<span class="blog-card__shade"></span>
		{category && <span class="blog-card__category">{category}</span>}
		<strong><mark>{highlight}</mark>{rest && ` ${rest}`}</strong>
	</a>
	<div class="blog-card__body">
		{
			date && (
				<time datetime={date.toISOString()}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
					{formatShortDate(date)}
				</time>
			)
		}
		<h2><a href={href}>{title}</a></h2>
		<p>{excerpt || "Leia o conteúdo completo no Blog GoEPI."}</p>
		<a class="blog-card__cta" href={href}>Ler mais <span aria-hidden="true"><img src="/goepi/arrow-right.png" alt="" /></span></a>
	</div>
</article>
