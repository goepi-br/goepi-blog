---
/**
 * Google Tag Manager (GTM-TP9DTW3V), igual ao site goepi.com.br.
 * Carrega na primeira interação (rolar, tocar, clicar, teclar) ou 3,5 s depois
 * da página pronta, para não atrasar a primeira tela.
 * Vai no <head>; o <GoogleTagManagerNoscript /> vai logo após o <body>.
 */
---

<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() { dataLayer.push(arguments); }
	gtag("js", new Date());
	(function (w, d, id) {
		var loaded = false;
		function load() {
			if (loaded) return;
			loaded = true;
			w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
			var s = d.createElement("script");
			s.async = true;
			s.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
			d.head.appendChild(s);
		}
		["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (e) {
			w.addEventListener(e, load, { once: true, passive: true });
		});
		if (d.readyState === "complete") setTimeout(load, 3500);
		else w.addEventListener("load", function () { setTimeout(load, 3500); });
	})(window, document, "GTM-TP9DTW3V");
</script>
