---
import GoepiLayout from "../layouts/GoepiLayout.astro";
Astro.response.status = 404;
---

<GoepiLayout title="Página não encontrada" robots="noindex">
	<section class="blog-hero">
		<div class="blog-hero__glow" aria-hidden="true"></div>
		<div class="container blog-hero__inner">
			<h1>Página não encontrada</h1>
			<p>A página que você procura não existe ou mudou de endereço.</p>
		</div>
	</section>
	<section class="blog-listing" style="min-height: 0">
		<div class="container" style="text-align: center">
			<a class="blog-card__cta" href="/blog">Ver todos os artigos <span aria-hidden="true"><img src="/blog/assets/arrow-right.png" alt="" /></span></a>
		</div>
	</section>
</GoepiLayout>
