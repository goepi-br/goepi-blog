---
/**
 * Página de artigo do Blog GoEPI (itemBlog.pdf): hero com a imagem
 * destacada, resumo em destaque, conteúdo e artigos relacionados.
 */
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getEditMeta,
} from "emdash";
import { PortableText } from "emdash/ui";
import GoepiLayout from "../../layouts/GoepiLayout.astro";
import GoepiCard from "../../components/GoepiCard.astro";
import GoepiCtaBlock from "../../components/cta/GoepiCtaBlock.astro";
import SidebarCta from "../../components/cta/SidebarCta.astro";
import AiSummary from "../../components/cta/AiSummary.astro";
import { formatShortDate, imageUrl, splitTitle, FALLBACK_IMAGE, SITE_URL } from "../../utils/goepi";
import { injectCtas, pickVariant } from "../../utils/blog-cta";
import { buildPostJsonLd } from "../../utils/blog-schema";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const title = post.data.title || "Sem título";
const [highlight, rest] = splitTitle(title);
const heroImage = imageUrl(post.data.featured_image);
const absoluteImage = heroImage.startsWith("http") ? heroImage : `${Astro.url.origin}${heroImage}`;

const seo = getSeoMeta(post, {
	siteTitle: "Blog GoEPI",
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: heroImage === FALLBACK_IMAGE ? undefined : absoluteImage,
});

// CTAs de conversão (src/utils/blog-cta.ts). No modo de edição o conteúdo
// vai intacto para o editor do EmDash.
const ctaVariant = pickVariant(title, slug);
const content = getEditMeta(post.data.content)
	? post.data.content
	: (injectCtas(post.data.content, ctaVariant) as typeof post.data.content);
const ptComponents = { type: { goepiCta: GoepiCtaBlock } };
const articleUrl = `${SITE_URL}/blog/${slug}`;

// JSON-LD: BlogPosting completo, BreadcrumbList e FAQPage (src/utils/blog-schema.ts).
const jsonLd = buildPostJsonLd({
	url: articleUrl,
	title,
	description: seo.description,
	content: post.data.content,
	coverImage: heroImage === FALLBACK_IMAGE ? null : heroImage,
	publishedAt: post.data.publishedAt ?? null,
	updatedAt: post.data.updatedAt ?? null,
});

const category = (post.data.terms?.category ?? [])[0] ?? null;
const publishedAt = post.data.publishedAt ?? null;

// Relacionados: mesma categoria primeiro, depois os mais recentes.
const { entries: recent, cacheHint: recentHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 30,
});
if (Astro.cache?.enabled) Astro.cache.set(recentHint);
const others = recent.filter((p) => p.id !== post.id);
const othersCategories = await getTermsForEntries(
	"posts",
	others.map((p) => p.data.id),
	"category",
);
const sameCategory = category
	? others.filter((p) => (othersCategories.get(p.data.id) ?? []).some((t) => t.slug === category.slug))
	: [];
const related = [...sameCategory, ...others.filter((p) => !sameCategory.includes(p))].slice(0, 3);
---

<GoepiLayout
	title={title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt?.toISOString() ?? null}
	bodyClass="blog-page blog-post-page"
	content={{ collection: "posts", id: post.data.id, slug }}
	jsonLd={jsonLd}
>
	<section class="article-hero">
		<div class="article-hero__image" style={`background-image: url(${JSON.stringify(heroImage)})`} aria-hidden="true"></div>
		<div class="article-hero__overlay" aria-hidden="true"></div>
		<div class="container article-hero__inner">
			<a class="article-back" href="/blog">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
				Voltar ao Blog
			</a>
			<h1 {...post.edit.title}><span class="goepi-highlight-text">{highlight}</span>{rest && ` ${rest}`}</h1>
			{
				publishedAt && (
					<time datetime={publishedAt.toISOString()}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
						{formatShortDate(publishedAt)}
					</time>
				)
			}
		</div>
	</section>

	<section class="article-content-section">
		<div class="article-layout">
			<article class="article-content">
				{post.data.excerpt && <p class="article-lead" {...post.edit.excerpt}>{post.data.excerpt}</p>}
				<AiSummary url={articleUrl} />
				<PortableText value={content} components={ptComponents} />
			</article>
			<aside class="article-sidebar" aria-label="Agende uma demonstração da GoEPI">
				<SidebarCta variant={ctaVariant.key} />
			</aside>
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="related-section">
				<div class="container">
					<h2>Artigos relacionados</h2>
					<div class="blog-grid blog-grid--related">
						{related.map((p) => (
							<GoepiCard
								slug={p.id}
								title={p.data.title || "Sem título"}
								excerpt={p.data.excerpt}
								image={p.data.featured_image}
								category={(othersCategories.get(p.data.id) ?? [])[0]?.label ?? null}
								date={p.data.publishedAt ?? null}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</GoepiLayout>

<script is:inline>
	/* Eventos dos CTAs do artigo. Usa window.goepiTrack (o mesmo helper do site
	   goepi.com.br, PR #18); se esta página não tiver o helper, define um igual:
	   evento no dataLayer (GTM) e gtag('event'). Também envia whatsapp_click
	   para links wa.me, como no site. */
	(function () {
		var w = window;
		w.dataLayer = w.dataLayer || [];
		if (typeof w.goepiTrack !== "function") {
			w.goepiTrack = function (name, params) {
				var data = { event: name };
				for (var k in params) if (Object.prototype.hasOwnProperty.call(params, k)) data[k] = params[k];
				w.dataLayer.push(data);
				if (typeof w.gtag === "function") w.gtag("event", name, params || {});
			};
			document.addEventListener(
				"click",
				function (e) {
					var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me/"]') : null;
					if (!a) return;
					w.goepiTrack("whatsapp_click", {
						link_url: a.href,
						link_text: (a.getAttribute("aria-label") || a.textContent || "").trim().slice(0, 100),
						page_path: location.pathname,
					});
				},
				true,
			);
		}
		document.addEventListener(
			"click",
			function (e) {
				var t = e.target && e.target.closest ? e.target : null;
				if (!t) return;
				var cta = t.closest("a[data-cta-position]");
				if (cta) {
					w.goepiTrack("cta_click", {
						cta_position: cta.getAttribute("data-cta-position"),
						cta_variant: cta.getAttribute("data-cta-variant"),
						page_path: location.pathname,
					});
					return;
				}
				var ai = t.closest("a[data-ai-tool]");
				if (ai) w.goepiTrack("ai_summary_click", { tool: ai.getAttribute("data-ai-tool"), page_path: location.pathname });
			},
			true,
		);
	})();
</script>

<style>
	/* Coluna do artigo + card fixo de CTA (só no desktop). */
	.article-sidebar {
		display: none;
	}
	@media (min-width: 1100px) {
		.article-layout {
			display: grid;
			grid-template-columns: minmax(0, 760px) 280px;
			gap: clamp(36px, 4vw, 64px);
			justify-content: center;
			align-items: start;
			max-width: 1180px;
			margin: 0 auto;
		}
		.article-layout > :global(.article-content) {
			max-width: none;
			margin: 0;
		}
		.article-sidebar {
			display: block;
			position: sticky;
			top: 108px;
		}
	}
</style>
